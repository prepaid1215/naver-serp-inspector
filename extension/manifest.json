{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "1.6.0",
  "description": "네이버 검색결과 관측과 경쟁 문서 비교로 상위노출 가설을 실험하는 로컬 분석기",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
