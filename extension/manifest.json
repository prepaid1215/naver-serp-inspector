{
  "manifest_version": 3,
  "name": "SERP Lens + NAVER Intelligence",
  "version": "1.4.0",
  "description": "네이버 검색 기록 변화와 직접 방문한 경쟁 문서 구조를 로컬에서 분석하고 AI 분석 요청문을 생성합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
