{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "1.7.0",
  "description": "네이버 검색 관측, 경쟁 문서 비교 및 대조군 변경 전후 실험을 로컬에서 진행합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
