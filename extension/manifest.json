{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "2.2.1",
  "description": "Plus 채팅에서 GitHub 요청 → 네이버 자동 수집 → 출처별 본문·구조 결과 반환",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://search.naver.com/*",
    "https://m.search.naver.com/*",
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*",
    "https://cafe.naver.com/*",
    "https://m.cafe.naver.com/*"
  ],
  "background": {
    "service_worker": "extension/naver-autopilot-background.js",
    "type": "module"
  }
}
