{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "2.0.0",
  "description": "네이버 검색·블로그·카페를 승인 후 수집하고 비공개 GitHub 연결로 ChatGPT에서 분석하도록 전달합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://search.naver.com/*",
    "https://m.search.naver.com/*",
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*",
    "https://cafe.naver.com/*",
    "https://m.cafe.naver.com/*"
  ]
}
