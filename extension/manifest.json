{
  "manifest_version": 3,
  "name": "SERP Lens — 네이버 검색결과 분석",
  "version": "1.3.1",
  "description": "현재 직접 열어 둔 네이버 검색 화면을 로컬에서 수집하고 블록·문서 순위와 도메인 등장 여부를 분석합니다.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
