{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "1.9.0",
  "description": "네이버 검색 수집, 본문 비교, 노출 패턴, 대조군 실험 및 실화면 검수를 5단계 통합 검증합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
