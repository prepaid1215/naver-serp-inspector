{
  "manifest_version": 3,
  "name": "SERP Lens · NAVER Rank Lab",
  "version": "1.8.0",
  "description": "네이버 검색 결과의 실제 화면 위치와 HTML 추정 결과를 스크린샷으로 검증하는 로컬 SERP 분석기",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "현재 네이버 검색결과 분석",
    "default_popup": "extension/popup.html"
  },
  "icons": {
    "128": "extension/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
